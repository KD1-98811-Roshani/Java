public class Circle {
private double myX ;
private double myY; 
private double Diameter;
	public Circle() {
	super();
	this.myX = 0;
	this.myY = 0;
	Diameter = 100;
}
	public double getMyX() {
		return myX;
	}
	public void setMyX(double myX) {
		this.myX = myX;
	}
	public double getMyY() {
		return myY;
	}
	public void setMyY(double myY) {
		this.myY = myY;
	}
	public double getDiameter() {
		return Diameter;
	}
	public void setDiameter(double diameter) {
		Diameter = diameter;
	}
	public  void print() {
		System.out.println("Diameter: "+Diameter);
		System.out.println("myX: "+myX);
		System.out.println("myY"+myY);
	}
	public void circleValue() throws NegativeDiameterException
	{
		Scanner sc=new Scanner(System.in);
		System.out.print("Enter Diameter: ");
		Diameter=sc.nextDouble();
		if(Diameter<0)
			throw new NegativeDiameterException("Diameter is negative");
 		System.out.print("Enter myX: ");
 		myX=sc.nextDouble();
		System.out.print("Enter myY: ");
		myY=sc.nextDouble();
		
		
	}
	
	
	public static void main(String[] args) throws NegativeDiameterException {
		Circle c=new Circle();
		c.print();
		try {
			c.circleValue();
		} catch (NegativeArraySizeException e) {
			System.out.println(e.getMessage());
		}
		
	}

}
